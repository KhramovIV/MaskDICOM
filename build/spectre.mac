#==============================================================================
# Пример макроса для запуска частиц с определенным спектром и из 
# определенного положения в Geant4.
#
# Этот макрос использует General Particle Source (GPS).
#==============================================================================

# --- Задание источника частиц ---
# Использование General Particle Source (GPS)
/gps/particle gamma

# --- Задание положения и углового распределения ---
# Тип источника: точка (Point)
/gps/pos/type Point

# Координаты источника (x, y, z) в миллиметрах
/gps/pos/centre 0. 0 0 mm

# Угловое распределение: изотропное (во все стороны)
/gps/direction 0 1 0

# --- Задание энергетического спектра ---
# Тип спектра: произвольный/гистограмма (User)
/gps/ene/type Arb

# Определение точек гистограммы (энергия, относительная интенсивность)
# Энергия задается в МэВ. Интенсивность - это относительная вероятность.
# Geant4 автоматически нормализует интенсивности.
# Формат: /gps/hist/point Энергия Интенсивность
/gps/hist/point 0.0007 0.0003
/gps/hist/point 0.1 0.5
/gps/hist/point 0.16 1.002
/gps/hist/point 0.23 1.5
/gps/hist/point 0.38 1.45
/gps/hist/point	0.52 1.09
/gps/hist/point	0.69 0.81
/gps/hist/point 1.21 0.4
/gps/hist/point 2.001 0.203
/gps/hist/point	3 0.1
/gps/hist/point	4 0.05
/gps/hist/point	5 0.02
/gps/hist/point 5.75 0.003

# Интерполяция между точками гистограммы: линейная
/gps/hist/inter Lin

# --- Запуск моделирования ---



/run/beamOn 10000
