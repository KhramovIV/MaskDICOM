
# Macro file for example B1
# 
# To be run preferably in batch, without graphics:
# % exampleB1 run2.mac
#
/run/numberOfThreads 10
/run/initialize
/run/printProgress 500000
#
/control/verbose 2
/run/verbose 2

# Форма 
/gps/pos/type Plane
/gps/pos/shape Square
/gps/pos/halfx 5 cm
/gps/pos/halfy 5 cm
/gps/pos/rot1 1 0 0
/gps/pos/rot2 0 1 0            

# Задаём частицу
/gps/particle gamma
/gps/direction 0 0 -1
/gps/pos/centre 0 0 90 cm
               
# Спектр частицы
/gps/ene/type Arb
/gps/hist/file ./spectre.txt
/gps/hist/inter Lin
            


/geom/z 1
/run/initialize
/run/beamOn 100000000

/geom/z 2
/run/initialize
/run/beamOn 100000000

/geom/z 3
/run/initialize
/run/beamOn 100000000

